# Application
# When using docker-compose, DB_HOST/REDIS_HOST, REQUIRE_DB and DB_* are overridden by compose.
NODE_ENV=development
PORT=5001
# Resume storage: local = disk under backend/uploads (served at /uploads); unset = S3 (production)
# STORAGE_TYPE=local
# DB required to start: false = optional (standalone Docker), true = exit if DB unavailable (compose/production)
REQUIRE_DB=false

# Database (PostgreSQL) — use DB_HOST=postgres, REDIS_HOST=redis when running in docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiring_platform
DB_USER=postgres
DB_PASSWORD=your_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Temporary signup behavior: set to true to auto-verify all new registrations
# Set to false once SMTP/email verification is ready.
AUTO_VERIFY_EMAIL_ON_REGISTER=true

# Email (SMTP)
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_CONNECTION_TIMEOUT_MS=30000
SMTP_GREETING_TIMEOUT_MS=15001
SMTP_USER=jobyt.in@spazorlabs.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=jobyt.in@spazorlabs.com

# AWS S3 + CloudFront
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=hiring-platform-files
AWS_CLOUDFRONT_URL=https://your-cloudfront-domain.cloudfront.net

# Cloudinary (required for upload/storage when Cloudinary is enabled)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Frontend URL (for CORS & email links)
FRONTEND_URL=http://localhost:3000

# External Python resume parser (FastAPI service)
# Example: http://localhost:8000/parse (local) or http://resume-parser:8000/parse (docker-compose)
PYTHON_RESUME_PARSER_URL=
PYTHON_RESUME_PARSER_TIMEOUT_MS=8000
# Optional shared secret; must match RESUME_PARSER_API_KEY in parser service
PYTHON_RESUME_PARSER_API_KEY=

# Credits
REGISTRATION_CREDIT_AMOUNT=50
JOB_POSTING_CREDIT_COST=10
# Balance below this (GET /credits/balance sets low_credit: true)
LOW_CREDIT_THRESHOLD=10

# OAuth (server-side verification)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Optional but recommended: must match GitHub OAuth app callback URL
GITHUB_REDIRECT_URI=http://localhost:3001/oauth/callback?provider=github

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
# Required for LinkedIn code exchange: must match LinkedIn app callback URL
LINKEDIN_REDIRECT_URI=http://localhost:3001/oauth/callback?provider=linkedin

# ─── AI Configuration ────────────────────────────────────────────────────────
# Groq API — powers text generation and AI candidate reasoning (strengths/weaknesses)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq model to use for text generation (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# xAI / Grok (Resume Builder)
# Set XAI_API_KEY to enable Resume Builder to use Grok (xAI). Leave empty to
# keep using the existing configured provider (Groq) and avoid changing other
# AI services.
XAI_API_KEY=your_xai_api_key_here
# Optional xAI model (default: grok-1)
XAI_MODEL=grok-1

# Embedding Provider Architecture
# Active provider: "openai" | "huggingface" | "gemini" (optional, auto-detected if keys exist)
EMBEDDING_PROVIDER=huggingface
# Embedding model name:
#   - For openai: text-embedding-3-small (default)
#   - For huggingface: sentence-transformers/all-mpnet-base-v2 (default)
#   - For gemini: gemini-embedding-001 (default)
EMBEDDING_MODEL=text-embedding-3-small
# Number of dimensions (default: 768 to match database and legacy Gemini embeddings)
EMBEDDING_DIMENSIONS=768

# HuggingFace — used for embeddings (when EMBEDDING_PROVIDER=huggingface)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Gemini — optional legacy provider for embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic / Claude Configuration (Required for Mock Interviews)
# Mandatory: Primary API key to enable mock interview features
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: Alias fallback key
CLAUDE_API_KEY=
# Optional: Model override (default: claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Semantic scoring via embeddings (requires active embedding provider; default: true)
ENABLE_SEMANTIC_SCORING=true

# AI reliability tuning (optional — defaults shown)
# AI_MAX_RETRIES=2
# AI_TIMEOUT_MS=30000
# AI_CIRCUIT_BREAKER_THRESHOLD=5
# AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# Set to true to skip AI health check on startup (saves one API call)
# SKIP_AI_HEALTH_CHECK=false
