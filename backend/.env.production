# Backend Environment Variables - Production
# Update these values for your production environment

NODE_ENV=production
PORT=5000

# Database (use your production database credentials)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=hiring_platform
DB_USER=your-db-user
DB_PASSWORD=your-secure-password

# Redis (use your production Redis instance)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# JWT (use a strong secret in production)
JWT_SECRET=your_strong_jwt_secret_min_32_chars_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# API Configuration
PYTHON_RESUME_PARSER_URL=https://api.yourdomain.com:8000/parse
PYTHON_RESUME_PARSER_TIMEOUT_MS=8000

# Credits
REGISTRATION_CREDIT_AMOUNT=50
JOB_POSTING_CREDIT_COST=10

# Database
DATABASE_URL="postgresql://your-db-user:your-secure-password@your-db-host:5432/hiring_platform?sslmode=require"

# OAuth (configure with your production OAuth provider credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://yourdomain.com/oauth/callback?provider=github
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://yourdomain.com/oauth/callback?provider=linkedin# Backend Environment Variables - Production
