generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin_audit_log {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id    String    @db.Uuid
  action      String    @db.VarChar(100)
  target_type String?   @db.VarChar(50)
  target_id   String?   @db.Uuid
  reason      String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model applicant_profiles {
  user_id       String    @id @db.Uuid
  name          String?   @db.VarChar(255)
  phone         String?   @db.VarChar(30)
  photo_url     String?   @db.VarChar(500)
  skills        String[]  @default([])
  experience    Json?     @default("[]")
  education     Json?     @default("[]")
  portfolio_url String?   @db.VarChar(500)
  github_url    String?   @db.VarChar(500)
  linkedin_url  String?   @db.VarChar(500)
  bio           String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model applications {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id                    String              @db.Uuid
  applicant_id              String              @db.Uuid
  cover_letter              String?
  resume_snapshot_url       String?             @db.VarChar(500)
  status                    application_status? @default(applied)
  status_updated_at         DateTime?           @default(now()) @db.Timestamptz(6)
  created_at                DateTime?           @default(now()) @db.Timestamptz(6)
  resume_id                 String?             @db.Uuid
  application_answers       Json                @default("[]")
  ai_strengths              Json?
  ai_weaknesses             Json?
  ai_summary                String?
  ai_reasoning_generated_at DateTime?           @db.Timestamptz(6)
  users                     users               @relation(fields: [applicant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobs                      jobs                @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pipeline_events           pipeline_events[]

  @@unique([job_id, applicant_id])
  @@index([applicant_id, created_at(sort: Desc)], map: "idx_applications_applicant")
  @@index([job_id, status], map: "idx_applications_job_status")
  @@index([job_id, applicant_id], map: "idx_applications_job_applicant")
}

model conversations {
  id                                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recruiter_id                            String     @db.Uuid
  applicant_id                            String     @db.Uuid
  job_id                                  String?    @db.Uuid
  last_message_at                         DateTime?  @default(now()) @db.Timestamptz(6)
  created_at                              DateTime?  @default(now()) @db.Timestamptz(6)
  users_conversations_applicant_idTousers users      @relation("conversations_applicant_idTousers", fields: [applicant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobs                                    jobs?      @relation(fields: [job_id], references: [id], onUpdate: NoAction)
  users_conversations_recruiter_idTousers users      @relation("conversations_recruiter_idTousers", fields: [recruiter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages                                messages[]

  @@unique([recruiter_id, applicant_id, job_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model credit_transactions {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String      @db.Uuid
  type          credit_type
  amount        Int
  balance_after Int
  description   String      @db.VarChar(255)
  reference_id  String?     @db.Uuid
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  status        String      @default("success") @db.VarChar(20)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_credit_tx_user")
}

model jobs {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recruiter_id          String                   @db.Uuid
  company_id            String?                  @db.Uuid
  companyName           String                   @default("Unknown Company") @map("company_name") @db.VarChar(255)
  company_logo          String?                  @db.VarChar(500)
  company_website       String?                  @db.VarChar(500)
  company_location      String?                  @db.VarChar(255)
  is_external_company   Boolean                  @default(false)
  source                String                   @default("recruiter") @db.VarChar(30)
  created_by            String?                  @db.Uuid
  title                 String                   @db.VarChar(255)
  location              String?                  @db.VarChar(255)
  salary_min            Int?
  salary_max            Int?
  type                  job_type                 @default(full_time)
  skills                String[]                 @default([])
  description           String
  status                job_status?              @default(draft)
  is_boosted            Boolean?                 @default(false)
  views_count           Int?                     @default(0)
  deleted_at            DateTime?                @db.Timestamptz(6)
  created_at            DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?                @default(now()) @db.Timestamptz(6)
  search_vector         Unsupported("tsvector")?
  application_questions Json                     @default("[]")
  job_approval_status   String?                  @default("approved") @db.VarChar(30)
  approved_by           String?                  @db.Uuid
  approved_at           DateTime?                @db.Timestamptz(6)
  description_embedding Json?
  ai_interview_sessions ai_interview_sessions[]
  applications          applications[]
  conversations         conversations[]
  interview_reports     interview_reports[]
  users                 users                    @relation(fields: [recruiter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  saved_jobs            saved_jobs[]
  approved_at                  DateTime?                @db.Timestamptz(6)
  coding_assessment_id         String?                  @db.Uuid
  active_assessment_version_id String?                  @db.Uuid
  applications                 applications[]
  conversations                conversations[]
  users                        users                    @relation(fields: [recruiter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  saved_jobs                   saved_jobs[]
  job_recommendations          job_recommendations[]
  linked_coding_assessment     coding_assessments?      @relation("JobLinkedAssessment", fields: [coding_assessment_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  active_assessment_version    assessment_versions?       @relation("JobActiveAssessmentVersion", fields: [active_assessment_version_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  coding_assessments_on_job    coding_assessments[]     @relation("AssessmentJob")
  assessment_versions_on_job   assessment_versions[]    @relation("AssessmentVersionJob")

  @@index([recruiter_id], map: "idx_jobs_recruiter")
  @@index([job_approval_status], map: "idx_jobs_approval_status")
  @@index([search_vector], map: "idx_jobs_search", type: Gin)
  @@index([skills], map: "idx_jobs_skills", type: Gin)
  @@index([deleted_at, status], map: "idx_jobs_deleted_status")
  @@index([job_approval_status, status, deleted_at, type], map: "idx_jobs_discovery")
  @@index([location], map: "idx_jobs_location")
  @@index([salary_min, salary_max], map: "idx_jobs_salary_range")
  @@index([status], map: "idx_jobs_status")
  @@index([type], map: "idx_jobs_type")
}

model messages {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  sender_id       String        @db.Uuid
  body            String
  read_at         DateTime?     @db.Timestamptz(6)
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at], map: "idx_messages_conversation")
}

model notifications {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String            @db.Uuid
  type       notification_type
  title      String            @db.VarChar(255)
  body       String
  read       Boolean?          @default(false)
  action_url String?           @db.VarChar(500)
  created_at DateTime?         @default(now()) @db.Timestamptz(6)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, read, created_at(sort: Desc)], map: "idx_notifications_user")
}

model payments {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String          @db.Uuid
  plan_id     String?         @db.Uuid
  amount      Decimal         @db.Decimal(10, 2)
  currency    String?         @default("INR") @db.VarChar(10)
  gateway_ref String?         @db.VarChar(255)
  status      payment_status? @default(pending)
  created_at  DateTime?       @default(now()) @db.Timestamptz(6)
  plans       plans?          @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model plans {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String     @db.VarChar(100)
  credits    Int
  price      Decimal    @db.Decimal(10, 2)
  currency   String?    @default("INR") @db.VarChar(10)
  is_active  Boolean?   @default(true)
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  payments   payments[]
}

model pipeline_events {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id  String              @db.Uuid
  previous_status application_status?
  new_status      application_status
  changed_by_id   String?             @db.Uuid
  notes           String?
  created_at      DateTime?           @default(now()) @db.Timestamptz(6)
  applications    applications        @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id], map: "idx_pipeline_events_application")
}

model recruiter_profiles {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @unique @db.Uuid
  name          String?  @db.VarChar(255)
  companyName   String?  @map("company_name") @db.VarChar(255)
  company_email String?  @unique @db.VarChar(255)
  industry      String?  @db.VarChar(100)
  description   String?
  company_size  String?  @db.VarChar(50)
  logo_url      String?  @db.VarChar(500)
  website       String?  @db.VarChar(500)
  location      String?  @db.VarChar(255)
  is_verified   Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model referrals {
  id                                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrer_id                        String    @db.Uuid
  referred_id                        String    @unique @db.Uuid
  referrer_credited                  Boolean?  @default(false)
  referred_credited                  Boolean?  @default(false)
  created_at                         DateTime? @default(now()) @db.Timestamptz(6)
  users_referrals_referred_idTousers users     @relation("referrals_referred_idTousers", fields: [referred_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_referrals_referrer_idTousers users     @relation("referrals_referrer_idTousers", fields: [referrer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model referral_redemptions {
  id                                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                       String    @unique @db.Uuid
  referrer_id                                   String    @db.Uuid
  created_at                                    DateTime? @default(now()) @db.Timestamptz(6)
  users_referral_redemptions_referrer_idTousers users     @relation("referral_redemptions_referrer_idTousers", fields: [referrer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_referral_redemptions_user_idTousers     users     @relation("referral_redemptions_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([referrer_id], map: "idx_referral_redemptions_referrer")
}

model saved_jobs {
  applicant_id String    @db.Uuid
  job_id       String    @db.Uuid
  saved_at     DateTime? @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [applicant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobs         jobs      @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([applicant_id, job_id])
}

/// Uploaded resume files (S3/CloudFront URL + metadata). One row per file; use is_default for application default.
/// DB enforces ≤1 default per user: partial unique index unique_default_resume_per_user (see migration 20260323150000).
model resumes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  file_url   String   @db.VarChar(500)
  file_name  String   @db.VarChar(255)
  file_size  Int?
  mime_type  String?  @db.VarChar(100)
  is_default Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_default], map: "idx_resumes_user_default")
  @@index([user_id, created_at(sort: Desc)], map: "idx_resumes_user_created_at")
}

model users {
  id                                              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                           String?                   @unique @db.VarChar(255)
  password_hash                                   String?                   @db.VarChar(255)
  auth_provider                                   auth_provider             @default(local)
  google_id                                       String?                   @unique @db.VarChar(255)
  github_id                                       String?                   @unique @db.VarChar(255)
  linkedin_id                                     String?                   @unique @db.VarChar(255)
  role                                            user_role
  is_verified                                     Boolean?                  @default(false)
  is_email_dummy                                  Boolean                   @default(false)
  email_verified                                  Boolean                   @default(false)
  email_verification_token                        String?                   @db.VarChar(255)
  email_verification_expires                      DateTime?                 @db.Timestamptz(6)
  verify_token                                    String?                   @db.VarChar(255)
  reset_token                                     String?                   @db.VarChar(255)
  reset_token_expires_at                          DateTime?                 @db.Timestamptz(6)
  referral_code                                   String                    @unique @db.VarChar(20)
  credit_balance                                  Int                       @default(0)
  email_alerts_enabled                            Boolean                   @default(true)
  whatsapp_alerts_enabled                         Boolean                   @default(true)
  push_alerts_enabled                             Boolean                   @default(false)
  created_at                                      DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime?                 @default(now()) @db.Timestamptz(6)
  admin_audit_log                                 admin_audit_log[]
  ai_interview_sessions                           ai_interview_sessions[]
  applicant_profiles                              applicant_profiles?
  applications                                    applications[]
  coach_sessions                                  coach_sessions[]
  conversations_conversations_applicant_idTousers conversations[]           @relation("conversations_applicant_idTousers")
  conversations_conversations_recruiter_idTousers conversations[]           @relation("conversations_recruiter_idTousers")
  credit_transactions                             credit_transactions[]
  device_tokens                                   device_tokens[]
  interview_reports                               interview_reports[]
  interview_responses                             interview_responses[]
  jobs                                            jobs[]
  messages                                        messages[]
  notifications                                   notifications[]
  payments                                        payments[]
  readiness_score_history                         readiness_score_history[]
  recruiter_profiles                              recruiter_profiles?
  referral_redemptions_referrer_idTousers         referral_redemptions[]    @relation("referral_redemptions_referrer_idTousers")
  referral_redemptions_user_idTousers             referral_redemptions?     @relation("referral_redemptions_user_idTousers")
  referrals_referrals_referred_idTousers          referrals?                @relation("referrals_referred_idTousers")
  referrals_referrals_referrer_idTousers          referrals[]               @relation("referrals_referrer_idTousers")
  resumes                                         resumes[]
  saved_jobs                                      saved_jobs[]
  job_recommendations                             job_recommendations[]
  coding_problems_created                         coding_problems[]           @relation("CodingProblemCreator")
  problem_versions_published                      problem_versions[]          @relation("ProblemVersionPublisher")
  problem_collections                             problem_collections[]
  coding_assessments                              coding_assessments[]
  assessment_versions_published                   assessment_versions[]       @relation("AssessmentVersionPublisher")
  assessment_sessions                             assessment_sessions[]
  practice_sessions                               practice_sessions[]
  coding_submissions                              coding_submissions[]
  execution_logs                                  execution_logs[]
}

enum auth_provider {
  local
  google
  github
  linkedin
}

enum application_status {
  applied
  in_review
  shortlisted
  interview
  offer
  hired
  rejected
}

enum credit_type {
  credit
  debit
}

enum job_status {
  draft
  active
  closed
}

enum job_type {
  full_time  @map("full-time")
  part_time  @map("part-time")
  contract
  remote
  internship
}

enum notification_type {
  job_match
  application_status
  new_message
  referral_joined
  low_credit
  payment_success
  payment_failed
  application_submitted
}

enum payment_status {
  pending
  success
  failed
  refunded
}

enum user_role {
  applicant
  recruiter
  admin
}

model device_tokens {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  token        String   @unique
  platform     String   @db.VarChar(20) // 'ios' or 'android'
  last_used_at DateTime @default(now()) @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model scheduler_logs {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_date        DateTime  @default(now()) @db.Date
  status          String    @default("started") @db.VarChar(30)
  users_processed Int       @default(0)
  emails_sent     Int       @default(0)
  whatsapp_sent   Int       @default(0)
  failures        Int       @default(0)
  error_message   String?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
}

// ── Coding Assessment Module ───────────────────────────────────────────────────

model coding_problems {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_by             String                 @db.Uuid
  title                  String                 @db.VarChar(255)
  slug                   String                 @db.VarChar(255)
  status                 coding_problem_status  @default(draft)
  current_version_number Int                    @default(0)
  difficulty             coding_difficulty      @default(medium)
  supported_languages    String[]               @default(["python", "javascript", "java", "cpp"])
  description            String                 @default("")
  constraints            String?
  hints                  Json?                  @default("[]")
  starter_code           Json                   @default("{}")
  time_limit_sec         Int                    @default(5)
  memory_limit_kb        Int                    @default(128000)
  tags                   String[]               @default([])
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at             DateTime?              @db.Timestamptz(6)
  users                  users                  @relation("CodingProblemCreator", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coding_test_cases      coding_test_cases[]
  problem_versions       problem_versions[]
  collection_problems    collection_problems[]
  assessment_problems    assessment_problems[]

  @@unique([created_by, slug])
  @@index([created_by, status], map: "idx_coding_problems_created_by_status")
  @@index([tags], map: "idx_coding_problems_tags", type: Gin)
}

model coding_test_cases {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problem_id      String          @db.Uuid
  input           String          @default("")
  expected_output String          @default("")
  is_hidden       Boolean         @default(false)
  is_sample       Boolean         @default(false)
  weight          Int             @default(1)
  order_index     Int             @default(0)
  explanation     String?
  coding_problems coding_problems @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([problem_id, order_index], map: "idx_coding_test_cases_problem")
}

model problem_versions {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problem_id                  String                        @db.Uuid
  version_number              Int
  title                       String                        @db.VarChar(255)
  description                 String
  constraints                 String?
  hints                       Json?                         @default("[]")
  difficulty                  coding_difficulty
  supported_languages         String[]
  starter_code                Json                          @default("{}")
  time_limit_sec              Int                           @default(5)
  memory_limit_kb             Int                           @default(128000)
  published_at                DateTime                      @default(now()) @db.Timestamptz(6)
  published_by                String                        @db.Uuid
  snapshot_hash               String                        @db.VarChar(64)
  coding_problems             coding_problems               @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                       users                         @relation("ProblemVersionPublisher", fields: [published_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  problem_version_test_cases  problem_version_test_cases[]
  assessment_version_problems assessment_version_problems[]
  practice_sessions           practice_sessions[]
  coding_submissions          coding_submissions[]
  execution_logs              execution_logs[]

  @@unique([problem_id, version_number])
}

model problem_version_test_cases {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  problem_version_id String           @db.Uuid
  input              String           @default("")
  expected_output    String           @default("")
  is_hidden          Boolean          @default(false)
  is_sample          Boolean          @default(false)
  weight             Int              @default(1)
  order_index        Int              @default(0)
  explanation        String?
  problem_versions   problem_versions @relation(fields: [problem_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([problem_version_id, order_index], map: "idx_pvtc_version")
}

model problem_collections {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_by          String                @db.Uuid
  name                String                @db.VarChar(255)
  description         String?
  is_shared           Boolean               @default(false)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  users               users                 @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collection_problems collection_problems[]

  @@index([created_by], map: "idx_problem_collections_created_by")
}

model collection_problems {
  collection_id       String              @db.Uuid
  problem_id          String              @db.Uuid
  order_index         Int                 @default(0)
  problem_collections problem_collections @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coding_problems     coding_problems     @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([collection_id, problem_id])
}

model coding_assessments {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recruiter_id           String                   @db.Uuid
  job_id                 String?                  @db.Uuid
  title                  String                   @db.VarChar(255)
  description            String?
  status                 coding_assessment_status @default(draft)
  current_version_number Int                      @default(0)
  passing_score          Int                      @default(70)
  time_limit_minutes     Int?
  max_attempts           Int                      @default(1)
  assessment_timing      assessment_timing        @default(post_apply)
  allow_resume           Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  users                  users                    @relation(fields: [recruiter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobs                   jobs?                    @relation("AssessmentJob", fields: [job_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  jobs_linked            jobs[]                   @relation("JobLinkedAssessment")
  assessment_problems    assessment_problems[]
  assessment_versions    assessment_versions[]

  @@index([recruiter_id], map: "idx_coding_assessments_recruiter")
}

model assessment_problems {
  assessment_id      String             @db.Uuid
  problem_id         String             @db.Uuid
  order_index        Int                @default(0)
  points             Int                @default(100)
  coding_assessments coding_assessments @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coding_problems    coding_problems    @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([assessment_id, problem_id])
}

model assessment_versions {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_id               String                        @db.Uuid
  version_number              Int
  title                       String                        @db.VarChar(255)
  description                 String?
  passing_score               Int                           @default(70)
  time_limit_minutes          Int?
  max_attempts                Int                           @default(1)
  assessment_timing           assessment_timing
  allow_resume                Boolean                       @default(true)
  job_id                      String?                       @db.Uuid
  job_snapshot                Json?
  published_at                DateTime                      @default(now()) @db.Timestamptz(6)
  published_by                String                        @db.Uuid
  snapshot_hash               String                        @db.VarChar(64)
  coding_assessments          coding_assessments            @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobs                        jobs?                         @relation("AssessmentVersionJob", fields: [job_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  jobs_active                 jobs[]                        @relation("JobActiveAssessmentVersion")
  users                       users                         @relation("AssessmentVersionPublisher", fields: [published_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment_version_problems assessment_version_problems[]
  assessment_sessions         assessment_sessions[]
  coding_submissions          coding_submissions[]

  @@unique([assessment_id, version_number])
}

model assessment_version_problems {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_version_id String              @db.Uuid
  problem_version_id    String              @db.Uuid
  order_index           Int                 @default(0)
  points                Int                 @default(100)
  problem_snapshot      Json                @default("{}")
  assessment_versions   assessment_versions @relation(fields: [assessment_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  problem_versions      problem_versions    @relation(fields: [problem_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assessment_version_id, order_index], map: "idx_avp_version")
}

model assessment_sessions {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessment_version_id String                    @db.Uuid
  user_id               String                    @db.Uuid
  application_id        String?                   @db.Uuid
  started_at            DateTime                  @default(now()) @db.Timestamptz(6)
  expires_at            DateTime?                 @db.Timestamptz(6)
  completed_at          DateTime?                 @db.Timestamptz(6)
  status                assessment_session_status @default(pending)
  remaining_time_seconds Int?
  attempt_number        Int                       @default(1)
  last_heartbeat_at     DateTime?                 @db.Timestamptz(6)
  current_problem_index Int                       @default(0)
  metadata              Json?
  assessment_versions   assessment_versions       @relation(fields: [assessment_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users                     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  applications          applications?             @relation(fields: [application_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  coding_submissions    coding_submissions[]
  execution_logs        execution_logs[]

  @@index([user_id, assessment_version_id], map: "idx_assessment_sessions_user_version")
  @@index([application_id], map: "idx_assessment_sessions_application")
  @@index([status, expires_at], map: "idx_assessment_sessions_status_expires")
}

model practice_sessions {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String           @db.Uuid
  problem_version_id String           @db.Uuid
  started_at         DateTime         @default(now()) @db.Timestamptz(6)
  completed_at       DateTime?        @db.Timestamptz(6)
  best_score         Int?
  attempts_count     Int              @default(0)
  solved             Boolean          @default(false)
  users              users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  problem_versions   problem_versions @relation(fields: [problem_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coding_submissions coding_submissions[]
  execution_logs     execution_logs[]

  @@index([user_id, started_at(sort: Desc)], map: "idx_practice_sessions_user")
  @@index([user_id, problem_version_id], map: "idx_practice_sessions_user_problem")
}

model coding_submissions {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                   @db.Uuid
  assessment_session_id String?                  @db.Uuid
  practice_session_id   String?                  @db.Uuid
  problem_version_id    String                   @db.Uuid
  assessment_version_id String?                  @db.Uuid
  application_id        String?                  @db.Uuid
  attempt_number        Int                      @default(1)
  language              String                   @db.VarChar(20)
  source_code           String
  status                coding_submission_status @default(pending)
  test_pass_count       Int                      @default(0)
  test_total_count      Int                      @default(0)
  score                 Int?
  passed                Boolean?
  execution_time_ms     Int?
  memory_kb             Int?
  assessment_snapshot   Json?
  problem_snapshot      Json?
  job_snapshot          Json?
  judge0_tokens         String[]                 @default([])
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)
  users                 users                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assessment_sessions   assessment_sessions?     @relation(fields: [assessment_session_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  practice_sessions     practice_sessions?       @relation(fields: [practice_session_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  problem_versions      problem_versions         @relation(fields: [problem_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment_versions   assessment_versions?     @relation(fields: [assessment_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  applications          applications?            @relation(fields: [application_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  submission_test_results submission_test_results[]
  code_evaluations      code_evaluations?

  @@index([user_id, created_at(sort: Desc)], map: "idx_coding_submissions_user_created")
  @@index([assessment_session_id], map: "idx_coding_submissions_session")
  @@index([problem_version_id, user_id, attempt_number], map: "idx_coding_submissions_problem_user")
}

model submission_test_results {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id      String             @db.Uuid
  test_case_id       String             @db.Uuid
  passed             Boolean
  actual_output      String?
  stderr             String?
  time_sec           Float?             @db.DoublePrecision
  memory_kb          Float?             @db.DoublePrecision
  status_id          Int?
  coding_submissions coding_submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([submission_id], map: "idx_submission_test_results_submission")
}

model code_evaluations {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id         String             @unique @db.Uuid
  readability_score     Int?
  maintainability_score Int?
  efficiency_score      Int?
  best_practices_score  Int?
  optimization_score    Int?
  overall_quality_score Int?
  strengths             Json                 @default("[]")
  weaknesses            Json                 @default("[]")
  suggestions           Json                 @default("[]")
  raw_response          Json?
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  coding_submissions    coding_submissions   @relation(fields: [submission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model execution_logs {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String               @db.Uuid
  problem_version_id    String?              @db.Uuid
  assessment_session_id String?              @db.Uuid
  practice_session_id   String?              @db.Uuid
  language              String               @db.VarChar(20)
  source_code           String
  stdin                 String?
  stdout                String?
  stderr                String?
  compile_output        String?
  execution_time_ms     Int?
  memory_kb             Int?
  status                String               @default("success") @db.VarChar(50)
  judge0_token          String?              @db.VarChar(255)
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  users                 users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  problem_versions      problem_versions?    @relation(fields: [problem_version_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assessment_sessions   assessment_sessions? @relation(fields: [assessment_session_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  practice_sessions     practice_sessions?   @relation(fields: [practice_session_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_execution_logs_user_created")
}

enum coding_problem_status {
  draft
  published
}

enum coding_difficulty {
  easy
  medium
  hard
}

enum coding_assessment_status {
  draft
  published
  archived
}

enum assessment_timing {
  during_apply
  post_apply
}

enum assessment_session_status {
  pending
  active
  submitted
  expired
  completed
}

enum coding_submission_status {
  pending
  running
  completed
  failed
}
