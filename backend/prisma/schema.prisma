generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin_audit_log {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  admin_id    String    @db.Uuid
  action      String    @db.VarChar(100)
  target_type String?   @db.VarChar(50)
  target_id   String?   @db.Uuid
  reason      String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model applicant_profiles {
  user_id       String    @id @db.Uuid
  name          String?   @db.VarChar(255)
  phone         String?   @db.VarChar(30)
  photo_url     String?   @db.VarChar(500)
  skills        String[]  @default([])
  experience    Json?     @default("[]")
  education     Json?     @default("[]")
  resume_url    String?   @db.VarChar(500)
  portfolio_url String?   @db.VarChar(500)
  github_url    String?   @db.VarChar(500)
  linkedin_url  String?   @db.VarChar(500)
  bio           String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model applications {
  id                  String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  job_id              String              @db.Uuid
  applicant_id        String              @db.Uuid
  cover_letter        String?
  resume_snapshot_url String?             @db.VarChar(500)
  status              application_status? @default(applied)
  status_updated_at   DateTime?           @default(now()) @db.Timestamptz(6)
  created_at          DateTime?           @default(now()) @db.Timestamptz(6)
  users               users               @relation(fields: [applicant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobs                jobs                @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([job_id, applicant_id])
  @@index([applicant_id, created_at(sort: Desc)], map: "idx_applications_applicant")
  @@index([job_id, status], map: "idx_applications_job_status")
}

model conversations {
  id                                      String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recruiter_id                            String     @db.Uuid
  applicant_id                            String     @db.Uuid
  job_id                                  String?    @db.Uuid
  last_message_at                         DateTime?  @default(now()) @db.Timestamptz(6)
  created_at                              DateTime?  @default(now()) @db.Timestamptz(6)
  users_conversations_applicant_idTousers users      @relation("conversations_applicant_idTousers", fields: [applicant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobs                                    jobs?      @relation(fields: [job_id], references: [id], onUpdate: NoAction)
  users_conversations_recruiter_idTousers users      @relation("conversations_recruiter_idTousers", fields: [recruiter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages                                messages[]

  @@unique([recruiter_id, applicant_id, job_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model credit_transactions {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String      @db.Uuid
  type          credit_type
  amount        Int
  balance_after Int
  description   String      @db.VarChar(255)
  reference_id  String?     @db.Uuid
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_credit_tx_user")
}

model jobs {
  id            String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recruiter_id  String                   @db.Uuid
  title         String                   @db.VarChar(255)
  location      String?                  @db.VarChar(255)
  salary_min    Int?
  salary_max    Int?
  type          job_type                 @default(full_time)
  skills        String[]                 @default([])
  description   String
  status        job_status?              @default(draft)
  is_boosted    Boolean?                 @default(false)
  views_count   Int?                     @default(0)
  deleted_at    DateTime?                @db.Timestamptz(6)
  created_at    DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?                @default(now()) @db.Timestamptz(6)
  search_vector Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, (COALESCE(title, ''::character varying))::text), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))
  applications  applications[]
  conversations conversations[]
  users         users                    @relation(fields: [recruiter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  saved_jobs    saved_jobs[]

  @@index([recruiter_id], map: "idx_jobs_recruiter")
  @@index([search_vector], map: "idx_jobs_search", type: Gin)
  @@index([skills], map: "idx_jobs_skills", type: Gin)
}

model messages {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversation_id String        @db.Uuid
  sender_id       String        @db.Uuid
  body            String
  read_at         DateTime?     @db.Timestamptz(6)
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at], map: "idx_messages_conversation")
}

model notifications {
  id         String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String            @db.Uuid
  type       notification_type
  title      String            @db.VarChar(255)
  body       String
  read       Boolean?          @default(false)
  action_url String?           @db.VarChar(500)
  created_at DateTime?         @default(now()) @db.Timestamptz(6)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, read, created_at(sort: Desc)], map: "idx_notifications_user")
}

model payments {
  id          String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String          @db.Uuid
  plan_id     String?         @db.Uuid
  amount      Decimal         @db.Decimal(10, 2)
  currency    String?         @default("INR") @db.VarChar(10)
  gateway_ref String?         @db.VarChar(255)
  status      payment_status? @default(pending)
  created_at  DateTime?       @default(now()) @db.Timestamptz(6)
  plans       plans?          @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model plans {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String     @db.VarChar(100)
  credits    Int
  price      Decimal    @db.Decimal(10, 2)
  currency   String?    @default("INR") @db.VarChar(10)
  is_active  Boolean?   @default(true)
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  payments   payments[]
}

model recruiter_profiles {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String   @unique @db.Uuid
  name          String?  @db.VarChar(255)
  company_name  String?  @db.VarChar(255)
  company_email String?  @unique @db.VarChar(255)
  industry      String?  @db.VarChar(100)
  description   String?
  company_size  String?  @db.VarChar(50)
  logo_url      String?  @db.VarChar(500)
  website       String?  @db.VarChar(500)
  location      String?  @db.VarChar(255)
  is_verified   Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model referrals {
  id                                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  referrer_id                        String    @db.Uuid
  referred_id                        String    @unique @db.Uuid
  referrer_credited                  Boolean?  @default(false)
  referred_credited                  Boolean?  @default(false)
  created_at                         DateTime? @default(now()) @db.Timestamptz(6)
  users_referrals_referred_idTousers users     @relation("referrals_referred_idTousers", fields: [referred_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_referrals_referrer_idTousers users     @relation("referrals_referrer_idTousers", fields: [referrer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model saved_jobs {
  applicant_id String    @db.Uuid
  job_id       String    @db.Uuid
  saved_at     DateTime? @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [applicant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jobs         jobs      @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([applicant_id, job_id])
}

model users {
  id                                              String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                                           String                @unique @db.VarChar(255)
  password_hash                                   String                @db.VarChar(255)
  role                                            user_role
  is_verified                                     Boolean?              @default(false)
  verify_token                                    String?               @db.VarChar(255)
  reset_token                                     String?               @db.VarChar(255)
  reset_token_expires_at                          DateTime?             @db.Timestamptz(6)
  referral_code                                   String                @unique @db.VarChar(20)
  credit_balance                                  Int                   @default(0)
  created_at                                      DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime?             @default(now()) @db.Timestamptz(6)
  admin_audit_log                                 admin_audit_log[]
  applicant_profiles                              applicant_profiles?
  applications                                    applications[]
  conversations_conversations_applicant_idTousers conversations[]       @relation("conversations_applicant_idTousers")
  conversations_conversations_recruiter_idTousers conversations[]       @relation("conversations_recruiter_idTousers")
  credit_transactions                             credit_transactions[]
  jobs                                            jobs[]
  messages                                        messages[]
  notifications                                   notifications[]
  payments                                        payments[]
  recruiter_profiles                              recruiter_profiles?
  referrals_referrals_referred_idTousers          referrals?            @relation("referrals_referred_idTousers")
  referrals_referrals_referrer_idTousers          referrals[]           @relation("referrals_referrer_idTousers")
  saved_jobs                                      saved_jobs[]
}

enum application_status {
  applied
  in_review
  shortlisted
  interview
  offer
  hired
  rejected
}

enum credit_type {
  credit
  debit
}

enum job_status {
  draft
  active
  closed
}

enum job_type {
  full_time  @map("full-time")
  part_time  @map("part-time")
  contract
  remote
  internship
}

enum notification_type {
  job_match
  application_status
  new_message
  referral_joined
  low_credit
  payment_success
  payment_failed
  application_submitted
}

enum payment_status {
  pending
  success
  failed
  refunded
}

enum user_role {
  applicant
  recruiter
  admin
}
