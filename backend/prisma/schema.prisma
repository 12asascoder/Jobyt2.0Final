/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model interview_responses {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  question_id           String                @db.Uuid
  session_id            String                @db.Uuid
  student_id            String                @db.Uuid
  response_text         String
  ai_score              Int?
  rubric_scores         Json?
  ai_feedback           Json?
  evaluated_at          DateTime?             @db.Timestamptz(6)
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime              @default(now()) @db.Timestamptz(6)
  interview_questions   interview_questions   @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ai_interview_sessions ai_interview_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users                 @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, question_id, student_id], map: "uq_interview_responses_session_question_student")
  @@index([question_id], map: "idx_interview_responses_question")
  @@index([session_id], map: "idx_interview_responses_session")
  @@index([student_id, created_at(sort: Desc)], map: "idx_interview_responses_student_created_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model readiness_score_history {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  student_id            String                @db.Uuid
  session_id            String                @db.Uuid
  previous_score        Int?
  interview_score       Int
  new_score             Int
  trend                 String                @db.VarChar(30)
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  ai_interview_sessions ai_interview_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users                 @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, session_id], map: "uq_readiness_score_history_student_session")
  @@index([session_id], map: "idx_readiness_score_history_session")
  @@index([student_id, created_at(sort: Desc)], map: "idx_readiness_score_history_student_created_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model student_readiness_scores {
  student_id                String                 @id @db.Uuid
  current_score             Int                    @default(0)
  trend                     String                 @default("stable") @db.VarChar(30)
  last_interview_session_id String?                @db.Uuid
  last_updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  created_at                DateTime               @default(now()) @db.Timestamptz(6)
  ai_interview_sessions     ai_interview_sessions? @relation(fields: [last_interview_session_id], references: [id], onUpdate: NoAction)
  users                     users                  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([last_updated_at(sort: Desc)], map: "idx_student_readiness_scores_updated_at")
}

